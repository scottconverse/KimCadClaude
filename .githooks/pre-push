#!/bin/sh
# Local CI gate: block the push if lint or tests fail.
# Activated with: git config core.hooksPath .githooks
#
# Scope (2026-06-15): the full ~14-min live-tool gate exists to protect `main` and release tags.
# Feature / coordination branches are gated by the GitHub Actions check when they open a PR, and by
# this same hook when their result lands on `main`, so running the whole suite on every WIP
# feature-branch push is pure waste (and makes a low-latency branch workflow — e.g. the `tester`
# coordination branch — impossible). Read the refs being pushed (git feeds
# "<local> <lsha> <remote> <rsha>" lines on stdin) and run the gate only when `main` or a tag is in
# the push set. `main` is never weaker than CI; only non-main WIP pushes skip the local suite.
root="$(git rev-parse --show-toplevel)"

needs_gate=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/tags/*) needs_gate=1 ;;
    esac
done
if [ "$needs_gate" -eq 0 ]; then
    echo "[pre-push] non-main/tag push (feature or coordination branch) — the full gate runs at merge to main; skipping the local suite here."
    exit 0
fi

echo "[pre-push] pushing main/tag — running the full ci.sh gate (the authoritative local gate)..."
# Gate-integrity 2026-06-13: run under bash with `-o pipefail` when available, matching the CI
# workflow (.github/workflows/ci.yml) exactly so a local push is never weaker than CI — a pipe in
# the gate must not mask a failure. ci.sh also self-protects (captures pytest's real exit code), so
# the plain-`sh` fallback stays correct on a box without bash.
if command -v bash >/dev/null 2>&1; then
    exec bash --noprofile --norc -eo pipefail "$root/scripts/ci.sh"
fi
exec sh "$root/scripts/ci.sh"
